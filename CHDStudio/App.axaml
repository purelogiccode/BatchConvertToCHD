<Application
    x:Class="CHDStudio.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ==================== WINDOW / TEXT ==================== -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.headerTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#e6edf3" />
        </Style>

        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="#8b949e" />
        </Style>

        <!-- ==================== STAT CARDS ==================== -->
        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- ==================== BUTTONS ==================== -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.info">
            <Setter Property="Background" Value="#03A9F4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#039BE5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.info:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0288D1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#73C2FF" />
            <Setter Property="Foreground" Value="#0A0A0A" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8FCDFF" />
            <Setter Property="Foreground" Value="#0A0A0A" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5FB2F0" />
            <Setter Property="Foreground" Value="#0A0A0A" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5AB55E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.success:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#43A047" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D13438" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#58a6ff" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#79b8ff" />
        </Style>

        <!-- Caption buttons in the custom title bar -->
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>

        <!-- ==================== TABS ==================== -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="#8b949e" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#73C2FF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ==================== DATAGRID ==================== -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#0A0A0A" />
            <Setter Property="Foreground" Value="#e6edf3" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowBackground" Value="#2B2B2B" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="False" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ==================== EXPANDER ==================== -->
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- ==================== GROUP BOX (Border based) ==================== -->
        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="TextBlock.groupBoxHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#e6edf3" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- ==================== SHARED DIMENSIONS ==================== -->
        <x:Double x:Key="LabelColumnWidth">120</x:Double>
        <x:Double x:Key="NarrowColumnWidth">80</x:Double>
        <x:Double x:Key="WideColumnWidth">130</x:Double>

        <!-- ==================== TERMINAL COLORS ==================== -->
        <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0A0A0A" />
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#FFFFFF" />

        <!-- ==================== TEXT COLORS ==================== -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#e6edf3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8b949e" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6e7681" />
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />

        <!-- Status Text Colors -->
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="FailedTextBrush" Color="#F85149" />
        <SolidColorBrush x:Key="SkippedTextBrush" Color="#ffa726" />
        <SolidColorBrush x:Key="LinkTextBrush" Color="#58a6ff" />
        <SolidColorBrush x:Key="InfoTextBrush" Color="#00bcd4" />

        <!-- ==================== FLUENT-LIKE SURFACES ==================== -->
        <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#202020" />
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#313131" />
        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#73C2FF" />
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0A0A0A" />

        <!-- ==================== EXPANDER THEME ==================== -->
        <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <ToggleButton
                            Name="PART_toggle"
                            Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border
                                        Name="HeaderBorder"
                                        Background="#2B2B2B"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="15,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                            <Path
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Data="M0,0 L5,5 L10,0"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="1.5"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                            <Path
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Data="M0,5 L5,0 L10,5"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="1.5"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            IsVisible="{TemplateBinding IsExpanded}"
                            Margin="0,5,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Application.Resources>
</Application>
