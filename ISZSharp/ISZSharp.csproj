<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <Company>PureLogicCode.com</Company>
        <AssemblyVersion>1.0.1</AssemblyVersion>
        <FileVersion>1.0.1</FileVersion>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <!-- NuGet Package Metadata -->
        <IsPackable>true</IsPackable>
        <PackageId>ISZSharp</PackageId>
        <Version>1.0.1</Version>
        <Authors>PureLogicCode.com</Authors>
        <Title>ISZSharp</Title>
        <Description>A managed C# library for decompressing UltraISO ISZ disc images back to the plain images they were made from. Supports whole and split ISZ images with zlib, bzip2, stored and zero-elided chunks, the obfuscated chunk and segment tables and stripped bzip2 headers real UltraISO files carry, images with no chunk table, and the three segment naming schemes writers use. Validates the UltraISO checksum when the file carries one, and refuses encrypted or damaged files by name. Ideal for disc image preservation and emulation workflows.</Description>
        <PackageTags>isz;ultraiso;disc-image;decompress;zlib;bzip2;iso;conversion;emulation</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/purelogiccode/BatchConvertToCHD</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/purelogiccode/BatchConvertToCHD</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>PureLogicCode.com</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="icon\icon.png" Pack="true" PackagePath="icon.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SharpCompress" Version="0.50.4" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.264">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>BatchConvertToCHD.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>